{
  "name": "freelance-crm",
  "version": "0.1.0",
  "description": "Desktop CRM for freelancers",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && pnpm i18n && lefthook install || echo ''",
    "check": "svelte-kit sync && pnpm i18n && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "bindings": "UPDATE_BINDINGS=1 cargo test -p freelance-crm bindings_are_up_to_date",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy globalVariable baseLocale",
    "verify": "bash scripts/verify.sh",
    "coverage:rust": "cargo llvm-cov -p crm-core -p crm-pdf --summary-only --fail-under-lines 85",
    "check:build": "node scripts/check-build.mjs",
    "e2e": "wdio run e2e/wdio.conf.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.63.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "dompurify": "^3.4.17",
    "layerchart": "2.9.1",
    "marked": "^18.1.2",
    "svelte-dnd-action": "^0.9.80",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.29.2",
    "@inlang/plugin-message-format": "^4.5.5",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "1.5.1",
    "@wdio/tauri-service": "1.5.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.16",
    "vitest": "^5.0.5",
    "webdriverio": "^9.32.0"
  },
  "packageManager": "pnpm@10.32.1"
}
